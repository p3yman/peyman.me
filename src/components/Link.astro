---
const { to, variant = "primary", size = "md", target = "_self" } = Astro.props;
---

<a
  href={to}
  target={target}
  data-variant={variant}
  data-size={size}
  class="link-button"
>
  <slot />
</a>

<style>
  .link-button {
    --bg: transparent;
    --fg: var(--color-primary);
    --border: var(--color-primary);

    display: inline-block;
    border: 1px solid var(--border);
    border-radius: 0.125rem;
    background: var(--bg);
    color: var(--fg);

    font-family: var(--font-mono);
    font-weight: 700;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;

    transition:
      background-color 150ms ease,
      color 150ms ease;
  }

  /* variants */
  .link-button[data-variant="primary"] {
    --bg: var(--color-primary);
    --fg: white;
  }

  .link-button[data-variant="primary"]:hover {
    --bg: var(--color-primary);
    --fg: white !important;
  }

  .link-button[data-variant="outline"]:hover {
    background: var(--color-primary);
    color: white;
  }

  /* sizes */
  .link-button[data-size="sm"] {
    font-size: 0.75rem;
    padding: 0.25rem 0.5rem;
  }

  .link-button[data-size="md"] {
    font-size: 0.875rem;
    padding: 0.5rem 1rem;
  }

  .link-button[data-size="lg"] {
    font-size: 1.125rem;
    padding: 0.75rem 1.5rem;
  }
</style>
