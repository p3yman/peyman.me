---
import ArrowLeft from "./icons/ArrowLeft.astro";
import ArrowRight from "./icons/ArrowRight.astro";

export interface Props {
  word: string;
  pronunciation: string;
  meaning: string;
  context?: string;
  date: string;
  prevDate?: string;
  nextDate?: string;
}

const { word, pronunciation, meaning, date, prevDate, nextDate } =
  Astro.props;

const formatDate = (dateStr: string) => {
  const date = new Date(dateStr);
  return date.toLocaleDateString("en-US", {
    weekday: "long",
    year: "numeric",
    month: "long",
    day: "numeric",
  });
};
---

<div class="word-card">
  <div class="card-container">
    <div class="card-header">
      <p class="header-label">
        Word of the Day
      </p>
      <h1 class="header-date">{formatDate(date)}</h1>
    </div>

    <hr class="divider" />

    <div class="word-content">
      <div class="content-inner">
        <h2 class="word-title">
          {word}
        </h2>

        <div>
          <p class="pronunciation">
            {pronunciation}
          </p>
        </div>

        <div class="meaning-container">
          <p class="meaning">
            "{meaning}"
          </p>
        </div>
      </div>
    </div>

    <hr class="divider" />

    <div class="navigation">
      <a
        href={prevDate ? `/word-of-the-day/${prevDate}` : undefined}
        data-enabled={prevDate ? "true" : "false"}
        class="nav-link"
      >
        <ArrowLeft class="nav-icon" />
        <span class="nav-label">Previous</span>
      </a>

      <a
        href={nextDate ? `/word-of-the-day/${nextDate}` : undefined}
        data-enabled={nextDate ? "true" : "false"}
        class="nav-link"
      >
        <span class="nav-label">Next</span>
        <ArrowRight class="nav-icon" />
      </a>
    </div>
  </div>
</div>

<style>
  .word-card {
    display: flex;
    align-items: center;
    justify-content: center;
    padding-block: var(--space-section);
  }

  .card-container {
    max-width: 42rem;
    width: 100%;
  }

  .card-header {
    text-align: center;
    margin-bottom: var(--space-xl);
  }

  .header-label {
    text-transform: uppercase;
    color: rgb(156, 163, 175);
    font-size: var(--text-sm);
    font-weight: 300;
    letter-spacing: 0.1em;
    margin-bottom: var(--space-sm);
  }

  .header-date {
    color: rgb(75, 85, 99);
    font-size: var(--text-lg);
    font-weight: 300;
  }

  .divider {
    margin-block: var(--space-xl);
    border-color: var(--color-gray-lighter);
  }

  .word-content {
    padding-inline: var(--space-xl);
    padding-block: var(--space-4xl);
    margin-block: var(--space-xl);
  }

  .content-inner {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  .word-title {
    font-size: var(--text-display);
    font-family: var(--font-serif);
    font-weight: 300;
    color: var(--color-gray-dark);
    letter-spacing: -0.025em;
    line-height: var(--leading-none);
    margin-bottom: var(--space-lg);
  }

  @media (min-width: 768px) {
    .word-title {
      font-size: var(--text-display-lg);
    }
  }

  .pronunciation {
    color: var(--color-gray-light);
    font-size: var(--text-xl);
    font-weight: 300;
    letter-spacing: 0.025em;
  }

  .meaning-container {
    max-width: 32rem;
    margin-inline: auto;
    margin-top: var(--space-2xl);
  }

  .meaning {
    color: var(--color-gray);
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    font-weight: 300;
  }

  .navigation {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    transition: var(--transition-all);
    color: var(--color-gray-light);
    cursor: default;
    text-decoration: none;
  }

  .nav-link[data-enabled="true"] {
    color: var(--color-gray-dark);
    cursor: pointer;
  }

  .nav-link[data-enabled="true"]:hover {
    color: var(--color-primary);
  }

  .nav-icon {
    width: 1rem;
    height: 1rem;
  }

  .nav-label {
    text-transform: uppercase;
    font-family: var(--font-mono);
  }
</style>
