---
import { Image } from "astro:assets";
import dayjs from "dayjs";
import DefaultLayout from "./Default.astro";
import StructuredData from "../components/StructuredData.astro";
import RelatedPosts from "../components/RelatedPosts.astro";
import { readingTime } from "../utils/readingTime";
import { SITE_TITLE } from "../configs";

const { title, date, cover, description, body, category, id } = Astro.props;
const formattedDate = dayjs(date).format("MMMM DD, YYYY");
const isoDate = dayjs(date).toISOString();
---

<DefaultLayout 
  title={title} 
  description={description}
  image={cover?.img?.src}
  type="article"
>
  <Fragment slot="head">
    <StructuredData 
      type="article" 
      data={{
        title,
        description,
        datePublished: isoDate,
        dateModified: isoDate,
        image: cover?.img?.src,
        category,
        url: Astro.url.href
      }}
    />
  </Fragment>
  <header class="blog-header">
    <div class="back-link">
      <a href="/blog" class="back-button">
        ← Back to blog
      </a>
    </div>
    <h1 class="blog-title">
      {title}
    </h1>
    <div class="blog-meta">
      <div class="categories">
        {
          category.map((cat: string) => (
            <span class="category-badge">
              {cat}
            </span>
          ))
        }
      </div>
      <div>{formattedDate}</div><span>|</span><div>
        {readingTime(body || "")} minutes read
      </div>
    </div>
  </header>
  {
    cover ? (
      <>
        <Image
          src={cover.img}
          alt={title}
          width={720}
          height={480}
          class={cover.credit ? "cover-img-with-credit" : "cover-img"}
        />
        {cover.credit && (
          <div class="cover-credit">
            Photo by{" "}
            <a
              href={cover.url}
              class="credit-link"
              target="_blank"
            >
              {cover.credit}
            </a>
          </div>
        )}
      </>
    ) : (
      <hr class="divider" />
    )
  }
  <slot />
</DefaultLayout>

<style>
  .blog-header {
    margin-bottom: var(--space-xl);
  }

  .back-link {
    margin-bottom: var(--space-xl);
  }

  .back-button {
    color: var(--color-gray-light);
    transition: var(--transition-colors);
  }

  .back-button:hover {
    color: var(--color-gray-dark);
  }

  .blog-title {
    color: var(--color-gray-dark);
    font-size: var(--text-display-sm);
    font-weight: 900;
    line-height: var(--leading-snug);
    padding-bottom: var(--space-lg);
    font-family: var(--font-serif);
  }

  .blog-meta {
    display: flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-gray-light);
    gap: var(--space-sm);
  }

  .categories {
    display: flex;
    gap: var(--space-xs);
    margin-right: var(--space-sm);
  }

  .category-badge {
    padding-inline: var(--space-sm);
    padding-block: var(--space-xs);
    border-radius: var(--radius-sm);
    background-color: var(--color-gray-lighter);
    color: var(--color-gray-dark);
  }

  .cover-img {
    margin-bottom: var(--space-xl);
  }

  .cover-img-with-credit {
    margin-bottom: var(--space-sm);
  }

  .cover-credit {
    text-align: center;
    color: var(--color-gray-light);
    margin-bottom: var(--space-xl);
    font-size: var(--text-sm);
  }

  .credit-link {
    text-decoration: underline;
    transition: var(--transition-colors);
  }

  .credit-link:hover {
    color: var(--color-primary);
  }

  .divider {
    border-top: 1px solid var(--color-gray-lighter);
    margin-bottom: var(--space-xl);
  }
</style>
