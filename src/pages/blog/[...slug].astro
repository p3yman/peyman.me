---
import { type CollectionEntry, getCollection, render } from "astro:content";
import BlogLayout from "../../layouts/Blog.astro";
import RelatedPosts from "../../components/RelatedPosts.astro";
import "remark-github-blockquote-alert/alert.css";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => {
    const id = post.id.split("/").pop();
    return {
      params: { id, slug: id },
      props: post,
    };
  });
}
type Props = CollectionEntry<"blog">;

const post = Astro.props;
const postID = post.data.id;
const { Content } = await render(post);
---

<style is:global>
  /* Additional prose styles are now in global.css */
</style>

<style>
  .prose-full {
    max-width: none;
  }

  .comments-section {
    margin-top: var(--space-2xl);
    border-top: 1px solid var(--color-gray-lighter);
    padding-top: var(--space-2xl);
  }
</style>

<BlogLayout {...post.data} body={post.body}>
  <div class="prose prose-full">
    <Content />
  </div>

  <RelatedPosts 
    currentPostId={postID}
    currentCategory={post.data.category}
  />

  <div class="comments-section">
    <script
      src="https://giscus.app/client.js"
      data-repo="p3yman/peyman.me"
      data-repo-id="R_kgDOKFTTaQ"
      data-category="Blog"
      data-category-id="DIC_kwDOKFTTac4CZZlm"
      data-mapping="specific-term"
      data-term={postID}
      data-strict="0"
      data-reactions-enabled="1"
      data-emit-metadata="0"
      data-input-position="bottom"
      data-theme="light"
      data-lang="en"
      crossorigin="anonymous"
      async></script>
  </div>
</BlogLayout>
