---
import { getCollection } from "astro:content";
import DefaultLayout from "../../layouts/Default.astro";

const recipes = (await getCollection("recipe"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .map((recipe) => {
    const id = recipe.id.split("/").pop();
    return {
      ...recipe,
      slug: id,
    };
  });
---

<DefaultLayout
  title="Recipes"
  description="A collection of my favorite recipes."
>
  <h1 class="page-title">Recipes.</h1>
  {
    recipes.map((recipe) => (
      <a href={`/recipes/${recipe.slug}`} class="recipe-item">
        <h3 class="recipe-name">{recipe.data.title}</h3>
        <div class="recipe-info">
          {recipe.data.prepTime && <span>Prep: {recipe.data.prepTime}m</span>}
          {recipe.data.cookTime && <span>Cook: {recipe.data.cookTime}m</span>}
        </div>
      </a>
    ))
  }
</DefaultLayout>

<style>
  .page-title {
    font-family: var(--font-serif);
    font-size: var(--text-display);
    font-weight: 700;
    padding-bottom: var(--space-2xl);
  }

  .recipe-item {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    border-bottom: 1px solid var(--color-gray-lighter);
    padding-block: var(--space-lg);
    text-decoration: none;
    transition: var(--transition-colors);
  }

  .recipe-item:last-child {
    border-bottom: none;
  }

  .recipe-name {
    flex: 1 1 0%;
    color: var(--color-secondary);
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: 700;
    line-height: var(--leading-snug);
    transition: var(--transition-colors);
  }

  .recipe-item:hover .recipe-name {
    color: var(--color-primary);
  }

  .recipe-info {
    display: flex;
    gap: var(--space-sm);
    font-size: var(--text-sm);
    color: var(--color-gray-light);
    font-family: var(--font-mono);
    padding-left: var(--space-lg);
  }
</style>
