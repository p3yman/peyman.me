---
import DefaultLayout from "../layouts/Default.astro";
import Link from "../components/Link.astro";
import StructuredData from "../components/StructuredData.astro";
---

<DefaultLayout
  title="404 - Page Not Found"
  description="Sorry, the page you're looking for doesn't exist. Browse our blog or return to the homepage."
  noindex={true}
>
  <Fragment slot="head">
    <StructuredData
      type="website"
      data={{
        name: "404 - Page Not Found",
        description: "Error page for content that could not be found.",
      }}
    />
  </Fragment>

  <div class="error-page">
    <div class="error-header">
      <h1 class="error-code">404</h1>
      <h2 class="error-title">Page Not Found</h2>
      <p class="error-message">
        Sorry, the page you're looking for doesn't exist. It might have been
        moved, deleted, or you entered the wrong URL.
      </p>
    </div>

    <div class="error-actions">
      <Link to="/"> Back to Home </Link>
      <Link to="/blog" variant="outline"> Browse Blog </Link>
    </div>

    <hr class="error-divider" />

    <div class="suggested-links">
      <h3 class="suggested-title">
        Maybe you are looking for one of these?
      </h3>
      <ul class="links-list">
        <li>
          <a href="/blog" class="link-item">Blog</a>
        </li>
        <li>
          <a href="/mentoring" class="link-item">Mentoring</a>
        </li>
        <li>
          <a href="mailto:salam@peyman.me" class="link-item">Contact</a>
        </li>
      </ul>
    </div>
  </div>
</DefaultLayout>

<style>
  .error-page {
    text-align: center;
    padding-block: var(8rem);
  }

  .error-header {
    margin-bottom: var(--space-xl);
  }

  .error-code {
    font-size: var(--text-display);
    font-weight: 900;
    font-family: var(--font-serif);
    color: var(--color-gray-dark);
    margin-bottom: var(--space-md);
  }

  .error-title {
    font-size: var(--text-2xl);
    font-family: var(--font-serif);
    color: var(--color-gray-dark);
    margin-bottom: var(--space-lg);
  }

  .error-message {
    max-width: 28rem;
    font-size: var(--text-lg);
    color: var(--color-gray);
    margin-bottom: var(--space-xl);
    margin-inline: auto;
  }

  .error-actions {
    display: flex;
    justify-content: center;
    gap: var(--space-md);
  }

  .error-divider {
    margin-block: var(--space-xl);
    border-color: var(--color-gray-lighter);
    border-style: dashed;
    border-width: 1px 0 0 0;
  }

  .suggested-links {
    margin-top: var(--space-2xl);
  }

  .suggested-title {
    font-size: var(--text-lg);
    font-family: var(--font-serif);
    color: var(--color-gray-dark);
    margin-bottom: var(--space-md);
  }

  .links-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    color: var(--color-gray);
  }

  .link-item {
    transition: var(--transition-colors);
  }

  .link-item:hover {
    color: var(--color-gray-dark);
  }
</style>
